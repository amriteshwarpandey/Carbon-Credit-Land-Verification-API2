ENVIRONMENT=development            # "production" refuses to start with default secrets / auto schema
DATABASE_URL=postgresql+psycopg2://carbon:carbon@localhost:5432/carbon
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# Browser origins allowed to call the API (JSON list)
# CORS_ORIGINS=["https://console.example.com"]

# Storage for certificates + evidence: local | s3
# STORAGE_BACKEND=s3
# S3_BUCKET=carbon-files
# S3_ENDPOINT_URL=http://minio:9000   # omit for AWS S3
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Evidence
# MAX_EVIDENCE_MB=10
# REQUIRE_EVIDENCE_FOR_APPROVAL=true

# Registry methodology factors (see app/data/methodology.json for the schema)
# METHODOLOGY_FILE=/data/vm0042.json
